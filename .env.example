# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: comma-separated guild ids for instant command registration during
# development. Leave empty to register commands globally (up to 1h to appear).
GUILD_IDS=

# Optional: KLIPY API key, which powers /gif. Get one at https://partner.klipy.com
# Without it the bot still runs, but /gif is not registered.
KLIPY_API_KEY=

# Optional: MyAnimeList API client id, the fallback for /anime and /manga when
# AniList is unavailable. Register an app at https://myanimelist.net/apiconfig
MAL_CLIENT_ID=

# Optional: MySQL, for features that need persistence (reminders, birthdays,
# quotes). Leave MYSQL_USER empty to run without them. The bot creates the
# database and its tables itself on first start.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=discord_v3

# Timezone that bare wall-clock input is read in, e.g. the date and time typed
# into "Remind me at...". Reminders are always stored in UTC.
TIMEZONE=Asia/Kuala_Lumpur

# Optional: channel id for daily birthday announcements at midnight in TIMEZONE.
# Birthdays can still be saved without this; the announcement task stays idle.
BIRTHDAY_CHANNEL_ID=

# Optional: posted to a server's system channel when someone joins. {member}
# becomes a mention, {guild} the server name. Remove the line to keep the
# default below; set it to nothing at all to post no greeting.
WELCOME_MESSAGE=Who simply add people in again... smh

# Optional: a local Ollama server, which powers the bot's chat character.
# Leave it empty and the bot never answers messages. Install Ollama, run
# `ollama pull qwen3:8b`, and point this at it. The model must already be
# pulled -- the bot will not download it.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Optional: channel where mentioning the bot starts a conversation. Replying to
# one of the bot's messages works in any channel, with or without this.
CHAT_CHANNEL_ID=

# Optional: channel id that message edits and deletions are logged to. The bot
# needs Send Messages there, and View Audit Log in the server to name who
# deleted what. Leave it empty and nothing is logged. Activity in this channel
# itself is never logged.
LOG_CHANNEL_ID=

# Optional: Redis, used purely as a cache (Pokemon card data, anime/manga
# search results). Nothing durable lives here — leave it empty and the bot
# simply fetches everything live.
REDIS_URL=redis://127.0.0.1:6379/0

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
